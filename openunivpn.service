[Unit]
Description=OpenUniVPN — H3C SecPath SSLVPN 开源替代客户端
Documentation=https://github.com/tsaitang404/openunivpn
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
SyslogIdentifier=openunivpn
# client.py 内部已完成认证（NetExtension + 双连接握手），无需 ExecStartPre
ExecStart=/usr/bin/python3 /opt/openunivpn/client.py
Restart=on-failure
RestartSec=10
# 清理 TUN 设备（"-" 前缀忽略失败；systemd 不支持 shell 重定向）
ExecStopPost=-/usr/bin/ip link del cnem0
# 安全加固（需写 /etc/resolv.conf 管理 VPN DNS，不能启用 ProtectSystem=full）
PrivateTmp=true

[Install]
WantedBy=multi-user.target
