[Unit]
Description=OpenUniVPN — H3C SecPath SSLVPN 开源替代客户端
Documentation=https://github.com/tsaitang404/openunivpn
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
SyslogIdentifier=openunivpn
ExecStartPre=/usr/bin/python3 /opt/openunivpn/auth.py
ExecStart=/usr/bin/python3 /opt/openunivpn/client.py
Restart=on-failure
RestartSec=10
# 清理 TUN 设备（与 client.py 默认 tun name 一致；改 tun name 时需同步修改）
ExecStopPost=/usr/bin/ip link del cnem0 2>/dev/null
# 安全加固
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
